[Unit]
Description=ZeroClaw Service
After=network.target
Wants=network.target

[Service]
Type=simple
User=zeroclaw
Group=zeroclaw
SupplementaryGroups=clawboard

ExecStartPre=/usr/bin/test -x /usr/local/bin/zeroclaw

ExecStart=/usr/local/bin/zeroclaw service start

WorkingDirectory=/var/lib/zeroclaw

Environment=DBUS_SESSION_BUS_ADDRESS=unix:path=/var/run/dbus/system_bus_socket

Restart=on-failure
RestartSec=5

StandardOutput=journal
StandardError=journal

# Hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/zeroclaw /var/run/dbus/system_bus_socket
ReadOnlyPaths=/opt/clawboard/venv
RestrictNamespaces=true
RestrictRealtime=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
