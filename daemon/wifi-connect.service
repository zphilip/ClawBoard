[Unit]
Description=WiFi Connect — Captive portal for WiFi provisioning
After=NetworkManager.service NetworkManager-wait-online.service
Wants=NetworkManager.service
Before=zeroclaw.service picoclaw.service clawboard.service

[Service]
Type=simple
User=root
ExecStart=/opt/wifi-connect/wifi-connect-gpio-launch.sh
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
