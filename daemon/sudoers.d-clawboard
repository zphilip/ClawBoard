# /etc/sudoers.d/clawboard
#
# Narrow sudo rules for the ClawBoard dashboard (runs as user: zero).
# Install:
#   sudo cp daemon/sudoers.d-clawboard /etc/sudoers.d/clawboard
#   sudo chmod 440 /etc/sudoers.d/clawboard
#   sudo visudo -c   # validate before relying on it

# ── Allow zero to run sudo without a terminal (needed for systemd services) ──
Defaults:zero !requiretty

# ── ZeroClaw service management ──────────────────────────────────────────────
zero ALL=(root) NOPASSWD: /usr/bin/systemctl restart zeroclaw.service
zero ALL=(root) NOPASSWD: /usr/bin/systemctl stop zeroclaw.service
zero ALL=(root) NOPASSWD: /usr/bin/systemctl start zeroclaw.service

# ── ZeroClaw config migration (run as zeroclaw account) ──────────────────────
zero ALL=(zeroclaw) NOPASSWD: /opt/zeroclaw/zeroclaw config migrate

# ── ZeroClaw config deploy (dashboard writes config.toml as zeroclaw user) ───
zero ALL=(root) NOPASSWD: /usr/bin/tee /var/lib/zeroclaw/.zeroclaw/config.toml
zero ALL=(root) NOPASSWD: /usr/bin/mkdir -p /var/lib/zeroclaw/.zeroclaw

# ── ZeroClaw runtime files (read by clawberry-proxy for TTS config) ──────────
# clawberry-proxy.service reads these via AmbientCapabilities=CAP_DAC_READ_SEARCH
# (no sudo needed as a service).  The rules below allow the same read when
# clawproxy is run interactively as user zero (e.g. for testing).
zero ALL=(root) NOPASSWD: /usr/bin/cat /var/lib/zeroclaw/.zeroclaw/config.toml
zero ALL=(root) NOPASSWD: /usr/bin/cat /var/lib/zeroclaw/.zeroclaw/.secret_key

# ── PicoClaw service management ─────────────────────────────────────────────
zero ALL=(root) NOPASSWD: /usr/bin/systemctl restart picoclaw.service
zero ALL=(root) NOPASSWD: /usr/bin/systemctl stop picoclaw.service
zero ALL=(root) NOPASSWD: /usr/bin/systemctl start picoclaw.service

# ── PicoClaw runtime files ───────────────────────────────────────────────────
# Note: clawberry-proxy.service reads these via AmbientCapabilities=CAP_DAC_READ_SEARCH
# (no sudo needed).  The rules below are kept only for interactive shell use.
zero ALL=(root) NOPASSWD: /usr/bin/cat /var/lib/picoclaw/.picoclaw/.picoclaw.pid
zero ALL=(root) NOPASSWD: /usr/bin/cat /var/lib/picoclaw/.picoclaw/.security.yml

# ── PicoClaw config deploy (dashboard writes config + security as zero user) ──
zero ALL=(root) NOPASSWD: /usr/bin/tee /var/lib/picoclaw/.picoclaw/config.json
zero ALL=(root) NOPASSWD: /usr/bin/tee /var/lib/picoclaw/.picoclaw/.security.yml
zero ALL=(root) NOPASSWD: /usr/bin/chmod 600 /var/lib/picoclaw/.picoclaw/.security.yml
zero ALL=(root) NOPASSWD: /usr/bin/chown picoclaw\:picoclaw /var/lib/picoclaw/.picoclaw/config.json
zero ALL=(root) NOPASSWD: /usr/bin/chown picoclaw\:picoclaw /var/lib/picoclaw/.picoclaw/.security.yml
zero ALL=(root) NOPASSWD: /usr/bin/mkdir -p /var/lib/picoclaw/.picoclaw

# ── WiFi-connect captive portal ───────────────────────────────────────────────
zero ALL=(root) NOPASSWD: /opt/wifi-connect/wifi-connect
zero ALL=(root) NOPASSWD: /usr/bin/systemctl stop dnsmasq
zero ALL=(root) NOPASSWD: /usr/bin/systemctl start dnsmasq

# ── ClawBerry Proxy service management ───────────────────────────────────────
zero ALL=(root) NOPASSWD: /usr/bin/systemctl restart clawberry-proxy.service
zero ALL=(root) NOPASSWD: /usr/bin/systemctl stop clawberry-proxy.service
zero ALL=(root) NOPASSWD: /usr/bin/systemctl start clawberry-proxy.service

# ── OpenClaw service management ─────────────────────────────────────────────
zero ALL=(root) NOPASSWD: /usr/bin/systemctl restart openclaw.service
zero ALL=(root) NOPASSWD: /usr/bin/systemctl stop openclaw.service
zero ALL=(root) NOPASSWD: /usr/bin/systemctl start openclaw.service

# ── OpenClaw user-service management via --machine (connects to openclaw user session) ──
zero ALL=(root) NOPASSWD: /usr/bin/systemctl --machine=openclaw@.host --user is-active openclaw.service
zero ALL=(root) NOPASSWD: /usr/bin/systemctl --machine=openclaw@.host --user is-enabled openclaw.service
zero ALL=(root) NOPASSWD: /usr/bin/systemctl --machine=openclaw@.host --user enable --now openclaw.service

# ── OpenClaw runtime files ───────────────────────────────────────────────────
zero ALL=(root) NOPASSWD: /usr/bin/cat /var/lib/openclaw/.openclaw/openclaw.json

# ── OpenClaw config deploy ───────────────────────────────────────────────────
zero ALL=(root) NOPASSWD: /usr/bin/tee /var/lib/openclaw/.openclaw/openclaw.json
zero ALL=(root) NOPASSWD: /usr/bin/chown openclaw\:openclaw /var/lib/openclaw/.openclaw/openclaw.json
zero ALL=(root) NOPASSWD: /usr/bin/mkdir -p /var/lib/openclaw/.openclaw

# ── OpenClaw CLI (login shell as openclaw user for correct environment) ───────
# 'sudo -u openclaw -i openclaw ...' runs /bin/bash on behalf of openclaw;
# the login shell is required so HOME, PATH and the CLI config are loaded.
zero ALL=(openclaw) NOPASSWD: /bin/bash

# ── Workspace-sync upgrade script ────────────────────────────────────────────
zero ALL=(root) NOPASSWD: /usr/bin/bash /usr/local/bin/clawberry-workspace-sync.sh

# ── ClawBoard venv — skill package management ────────────────────────────────
# All service accounts (zero, zeroclaw, picoclaw, openclaw) are in the
# `clawboard` group and the venv is group-writable, so they can run
#   /opt/clawboard/venv/bin/pip install <pkg>
# directly without sudo.  The sudo rules below are kept as a fallback for
# scripts that explicitly call sudo pip (e.g. skill install hooks).
zero      ALL=(root) NOPASSWD: /opt/clawboard/venv/bin/pip install *
zero      ALL=(root) NOPASSWD: /opt/clawboard/venv/bin/pip uninstall *
zeroclaw  ALL=(root) NOPASSWD: /opt/clawboard/venv/bin/pip install *
zeroclaw  ALL=(root) NOPASSWD: /opt/clawboard/venv/bin/pip uninstall *
picoclaw  ALL=(root) NOPASSWD: /opt/clawboard/venv/bin/pip install *
picoclaw  ALL=(root) NOPASSWD: /opt/clawboard/venv/bin/pip uninstall *
openclaw  ALL=(root) NOPASSWD: /opt/clawboard/venv/bin/pip install *
openclaw  ALL=(root) NOPASSWD: /opt/clawboard/venv/bin/pip uninstall *
