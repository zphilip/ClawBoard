[Unit]
Description=OpenClaw Gateway (v2026.4.27)
After=network-online.target
Wants=network-online.target
StartLimitBurst=5
StartLimitIntervalSec=60

[Service]
ExecStart=/usr/bin/node /usr/lib/node_modules/openclaw/dist/index.js gateway --port 18789
Restart=always
RestartSec=5
RestartPreventExitStatus=78
TimeoutStopSec=30
TimeoutStartSec=30
SuccessExitStatus=0 143
KillMode=control-group
SupplementaryGroups=clawboard
Environment=HOME=/var/lib/openclaw
Environment=TMPDIR=/tmp
Environment=PATH=/opt/clawboard/venv/bin:/usr/bin:/var/lib/openclaw/.local/bin:/var/lib/openclaw/.npm-global/bin:/var/lib/openclaw/bin:/var/lib/openclaw/.nix-profile/bin:/usr/local/bin:/bin
Environment=NODE_COMPILE_CACHE=/var/tmp/openclaw-compile-cache
Environment=OPENCLAW_NO_RESPAWN=1
Environment=OPENCLAW_GATEWAY_PORT=18789
Environment=OPENCLAW_SYSTEMD_UNIT=openclaw.service
Environment="OPENCLAW_WINDOWS_TASK_NAME=OpenClaw Gateway"
Environment=OPENCLAW_SERVICE_MARKER=openclaw
Environment=OPENCLAW_SERVICE_KIND=gateway
Environment=OPENCLAW_SERVICE_VERSION=2026.4.27

[Install]
WantedBy=default.target