[Unit]
Description=PicoClaw Service
After=network.target
Wants=network.target

[Service]
Type=simple
User=picoclaw
Group=picoclaw
SupplementaryGroups=clawboard

ExecStartPre=/usr/bin/test -x /usr/local/bin/picoclaw
# Kill any lingering process holding the gateway port (e.g. a manually-started
# instance that escaped systemd tracking).  The "-" prefix tells systemd to
# ignore non-zero exit codes when nothing is listening on the port.
ExecStartPre=-/bin/bash -c 'fuser -k 18790/tcp 2>/dev/null; sleep 0.5'

ExecStart=/usr/local/bin/picoclaw gateway

WorkingDirectory=/var/lib/picoclaw

Restart=on-failure
RestartSec=5

StandardOutput=journal
StandardError=journal

# Hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/picoclaw
ReadOnlyPaths=/opt/clawboard/venv
RestrictNamespaces=true
RestrictRealtime=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
