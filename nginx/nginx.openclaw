server {
    listen 18443 ssl;
    listen 80;          # 监听 HTTP
    server_name raspberrypi.local;

    # 这里的路径请根据你 ls /app/nginx/ 看到的文件名进行修改
    ssl_certificate /app/nginx/clawberry.local.pem;
    ssl_certificate_key /app/nginx/clawberry.local-key.pem;

    # 性能与安全基础配置
    ssl_session_cache shared:SSL:1m;
    ssl_session_timeout 5m;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers HIGH:!aNULL:!MD5;
    ssl_prefer_server_ciphers on;

    location / {
        proxy_pass http://127.0.0.1:18789; # 转发到 OpenClaw 端口
        
        # 必要的 Header 信息
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # 核心：支持 WebSocket (OpenClaw 通讯必须)
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";

        # 避免大文件上传超时
        proxy_read_timeout 86400s;
        proxy_send_timeout 86400s;        
    }
}
